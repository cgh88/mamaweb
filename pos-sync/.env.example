# POS 매출 수집 설정 — 이 파일을 .env로 복사해 값을 채우세요 (.env는 git에 올리지 않음)
# 스마일비즈 API 인증 토큰 (Bearer 뒤의 값만)
POS_API_TOKEN=
# 수집할 매장 코드 (쉼표 구분)
POS_STORE_CODES=7740030,7915301,7915302
# 매일 실행 시 어제 포함 며칠치를 다시 수집할지 (사후 취소/반품 반영)
POS_SYNC_DAYS=3
# PostgreSQL 접속 정보
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mamapos
PGUSER=mamapos
PGPASSWORD=

# 외부 데이터 (external.py, 없으면 해당 항목만 건너뜀)
# 공공데이터포털 일반 인증키(Decoding) — 기상청 지상(종관,ASOS) 일자료 조회서비스 + 단기예보 조회서비스 활용신청
DATA_GO_KR_KEY=
# 네이버 개발자센터 애플리케이션 (검색 API) — 없으면 Google 뉴스 RSS로 경쟁 브랜드 소식 수집
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
